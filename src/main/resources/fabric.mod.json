  "mixins": [
    "litematica-printer.mixins.json",
    "litematica-printer-implementation.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "java": ">=25",
    "minecraft": ">=26.2",
    "malilib": ">=0.29.0",
